[Unit]
Description=Droidloom host location broker
PartOf=droidloom.service
Requires=droidloom-location.socket

[Service]
ExecStart=/usr/bin/droidloom-location --socket %t/droidloom/location.sock
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
RestrictSUIDSGID=true
# As with audio, filesystem namespacing in a user unit would map only the host
# user and hide the GNSS HAL's UID from SO_PEERCRED.
