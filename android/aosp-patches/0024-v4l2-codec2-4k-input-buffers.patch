+    // smaller streams get the 4K size too.
+    return kInputBufferSizeFor4K;
 }
 }  // namespace
 
@@ -305,7 +308,7 @@ DecodeInterface::DecodeInterface(const std::string& name,
 
     addParameter(
             DefineParam(mMaxInputSize, C2_PARAMKEY_INPUT_MAX_BUFFER_SIZE)
-                    .withDefault(new C2StreamMaxBufferSizeInfo::input(0u, kInputBufferSizeFor1080p))
+                    .withDefault(new C2StreamMaxBufferSizeInfo::input(0u, kInputBufferSizeFor4K))
                     .withFields({
                             C2F(mMaxInputSize, value).any(),
                     })
