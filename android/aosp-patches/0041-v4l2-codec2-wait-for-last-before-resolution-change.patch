+    }
+}
+
+void V4L2Decoder::onResolutionChangeTimeout(uint32_t generation) {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    if (!mResolutionChangePending || generation != mResolutionChangeGeneration ||
+        mState == State::Error) {
+        return;
+    }
+    // Some drivers end the old sequence without marking a buffer (the
+    // driver then already finished the change), so do not wait forever.
+    ALOGW("No last buffer %d ms after the resolution change, switching anyway.",
+          kResolutionChangeTimeoutMs);
+    finishResolutionChange();
