+void V4L2Decoder::finishResolutionChange() {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    mResolutionChangePending = false;
+    ++mResolutionChangeGeneration;
+    if (!changeResolution()) {
