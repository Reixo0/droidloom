     return c;
 }
+bool isYuv(uint32_t format) {
+    return format == 0x3231564e || format == 0x3132564e;
+}
+// Capability bit 8: layer flags carry wp_color_representation coefficients
+// (bits 8-11) and range (bits 12-15), so YUV video can be placed directly.
+constexpr uint32_t kColorRepresentation = 1u << 8;
+// wp_color_representation_surface_v1 coefficients and range for an SDR YUV
+// dataspace, or zero for one the host could not show the same way.
+uint32_t yuvRepresentation(ui::Dataspace dataspace) {
+    using D = ui::Dataspace;
+    const auto standard = static_cast<D>(static_cast<int32_t>(dataspace) &
+                                         static_cast<int32_t>(D::STANDARD_MASK));
+    const auto transfer = static_cast<D>(static_cast<int32_t>(dataspace) &
+                                         static_cast<int32_t>(D::TRANSFER_MASK));
+    const auto range = static_cast<D>(static_cast<int32_t>(dataspace) &
+                                      static_cast<int32_t>(D::RANGE_MASK));
+    // An unknown YUV dataspace is BT.601 limited range, as RenderEngine reads it.
+    if (dataspace == D::UNKNOWN) return 4 | 2 << 4;
+    if (transfer != D::TRANSFER_UNSPECIFIED && transfer != D::TRANSFER_SMPTE_170M &&
+        transfer != D::TRANSFER_SRGB && transfer != D::TRANSFER_GAMMA2_2)
+        return 0;
+    uint32_t coefficients;
+    switch (standard) {
+        case D::STANDARD_BT709:
+            coefficients = 2;
+            break;
+        case D::STANDARD_UNSPECIFIED:
+        case D::STANDARD_BT601_625:
+        case D::STANDARD_BT601_625_UNADJUSTED:
+        case D::STANDARD_BT601_525:
+        case D::STANDARD_BT601_525_UNADJUSTED:
+            coefficients = 4;
+            break;
+        default:
+            return 0;
+    }
+    if (range == D::RANGE_FULL) return coefficients | 1 << 4;
+    if (range == D::RANGE_LIMITED || range == D::RANGE_UNSPECIFIED) return coefficients | 2 << 4;
+    return 0;
+}
