-    constexpr uint32_t ar = 0x34325241, xr = 0x34325258, ab = 0x34324241, xb = 0x34324258;
-    if (c->format != ar && c->format != xr && c->format != ab && c->format != xb) return nullptr;
+    // NV12/NV21 video also does, once its matrix and range travel with it.
+    constexpr uint32_t ar = 0x34325241, xr = 0x34325258, ab = 0x34324241, xb = 0x34324258,
+                       nv12 = 0x3231564e, nv21 = 0x3132564e;
+    if (c->format != ar && c->format != xr && c->format != ab && c->format != xb &&
+        c->format != nv12 && c->format != nv21)
