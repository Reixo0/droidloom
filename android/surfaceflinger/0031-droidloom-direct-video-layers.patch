Subject: [PATCH] Droidloom: video layers go to the host directly

YouTube's video layer is NV12 in a BT.709 dataspace, so every frame of a
playing video was composed by RenderEngine and then again by the host.
With the presenter's COLOR_REPRESENTATION capability, NV12/NV21 layers in
an SDR BT.601 or BT.709 dataspace are exported with their matrix and
range in the layer flags (bits 8-15, wp_color_representation values).
A video edge between logical pixels is widened to the next whole one,
stretching the picture by at most a pixel, so letterboxed video on a 2x
screen can be placed too.

diff --git a/services/surfaceflinger/DroidloomLayers.cpp b/services/surfaceflinger/DroidloomLayers.cpp
index df27324..1e3e605 100644
--- a/services/surfaceflinger/DroidloomLayers.cpp
+++ b/services/surfaceflinger/DroidloomLayers.cpp
@@ -378,6 +378,32 @@ bool onLogicalGrid(std::array<int32_t, 4> edges, std::array<uint32_t, 2> logical
     return on(edges[0], logical[0], width) && on(edges[1], logical[1], height) &&
             on(edges[2], logical[0], width) && on(edges[3], logical[1], height);
 }
+// Widen a rectangle to the nearest whole logical pixels around it, where those
+// are whole physical pixels too and inside the task; otherwise leave it.
+void snapToLogicalGrid(Rect* r, std::array<uint32_t, 2> logical, uint32_t width,
+                       uint32_t height) {
+    const auto snap = [](int32_t edge, uint32_t units, uint32_t pixels, bool up,
+                         int32_t* out) {
+        if (!units || !pixels) return true;
+        const int64_t scaled = static_cast<int64_t>(edge) * units;
+        int64_t whole = scaled / pixels;
+        if (up && scaled % pixels) whole++;
+        const int64_t back = whole * pixels;
+        if (back % units) return false;
+        *out = static_cast<int32_t>(back / units);
+        return true;
+    };
+    Rect snapped = *r;
+    if (!snap(r->left, logical[0], width, false, &snapped.left) ||
+        !snap(r->top, logical[1], height, false, &snapped.top) ||
+        !snap(r->right, logical[0], width, true, &snapped.right) ||
+        !snap(r->bottom, logical[1], height, true, &snapped.bottom))
+        return;
+    if (snapped.left < 0 || snapped.top < 0 || snapped.right > static_cast<int32_t>(width) ||
+        snapped.bottom > static_cast<int32_t>(height))
+        return;
+    *r = snapped;
+}
