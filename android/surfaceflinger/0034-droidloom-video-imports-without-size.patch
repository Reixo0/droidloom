Subject: [PATCH] Droidloom: keep video imports whose mapper reports no size

The mapper's handle can carry a zero size for the decoder's NV12
buffers. Spares of unknown size were never kept, so the video pool was
still imported anew each cycle and every new import composed a frame.
A video allocation without a size counts as 1.5 bytes per pixel, and
the first video layer logs the size it reports.

diff --git a/services/surfaceflinger/DroidloomImportRetention.h b/services/surfaceflinger/DroidloomImportRetention.h
index d1903cf..a951579 100644
--- a/services/surfaceflinger/DroidloomImportRetention.h
+++ b/services/surfaceflinger/DroidloomImportRetention.h
@@ -56,11 +56,15 @@ bool trimDroidloomImports(Cache& cache,
     for (uint64_t id : idle) {
         const auto& use = cache.at(id).use;
         auto layer = layers.find(use.layer);
+        // The mapper may not report a video allocation's size; NV12 needs
+        // at least 1.5 bytes per pixel.
+        const uint64_t videoSize =
+                use.bytes ? use.bytes : uint64_t{use.width} * use.height * 3 / 2;
         if (layer != layers.end() && use.compatible(layer->second) && use.video() &&
-            videoCount < kVideoSpares && use.bytes != 0 &&
-            use.bytes <= kVideoSpareBytes - videoBytes) {
+            videoCount < kVideoSpares && videoSize != 0 &&
+            videoSize <= kVideoSpareBytes - videoBytes) {
             ++videoCount;
-            videoBytes += use.bytes;
+            videoBytes += videoSize;
             continue;
         }
         if (layer != layers.end() && use.compatible(layer->second) && !use.video() &&
diff --git a/services/surfaceflinger/DroidloomLayers.cpp b/services/surfaceflinger/DroidloomLayers.cpp
index 8544cd1..13fb7a2 100644
--- a/services/surfaceflinger/DroidloomLayers.cpp
+++ b/services/surfaceflinger/DroidloomLayers.cpp
@@ -810,6 +810,10 @@ bool DroidloomLayers::presentFrame(compositionengine::Output& output, uint32_t w
         if (!h) return false;
         currentImports.emplace(e.buffer->getId(), DroidloomImportUse{
                 e.id, h->width, h->height, e.format, h->totalSize, mCacheSerial});
+        static std::atomic<bool> sizeLogged{false};
+        if (isYuv(e.format) && !sizeLogged.exchange(true))
+            ALOGI("Droidloom: video layer %ux%u reports %" PRIu64 " bytes per buffer", h->width,
+                  h->height, h->totalSize);
     }
     // A failed import holds nothing on the host. Kept as a spare it would
     // fail every scene that uses its buffer again, which for a video's
