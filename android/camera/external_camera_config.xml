<?xml version="1.0" encoding="utf-8"?>
<!--
  AOSP's external (V4L2) camera HAL, for the cameras the host hands Android:
  /dev/video0 and /dev/video1 in the cell are the host's back and front
  cameras as MJPEG (its devices named "Back camera" and "Front camera"),
  fed by its camera service. android/aosp-patches/0021
  adds the Camera entries, which make them back and front cameras instead
  of external ones. The host feeds landscape frames, so the orientations
  are those of a phone's sensors.
-->
<ExternalCamera>
    <Provider>
        <CameraIdOffset>0</CameraIdOffset>
        <ignore>
        </ignore>
    </Provider>
    <Device>
        <MaxJpegBufferSize bytes="3145728"/>
        <NumVideoBuffers count="4"/>
        <NumStillBuffers count="2"/>
        <FpsList>
            <Limit width="1024" height="768" fpsBound="30.0"/>
        </FpsList>
        <Camera node="0" facing="back" degree="90"/>
        <Camera node="1" facing="front" degree="270"/>
    </Device>
</ExternalCamera>
